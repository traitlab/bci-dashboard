# Labelbox API key (from https://app.labelbox.com → Settings → API Keys)
LABELBOX_API_KEY=your_labelbox_api_key_here

# Pl@ntNet API key (from https://my.plantnet.org)
PLANTNET_API_KEY=your_plantnet_api_key_here

# Optional. Which Labelbox workspace to point at. Not credentials: these open
# nothing on their own. Leave unset to use the defaults in config.yaml.
# LABELBOX_DATASET_ID=
# LABELBOX_PROJECT_ID=
